# ==============================================================================
# 📱 麦麦的手机 (WiseXin.phone-controller) 配置文件示例
# 
# 💡 提示：本配置文件采用标准的 TOML 格式。
#    带有 "#" 开头的行都是注释说明，不会生效。
#    请仔细阅读以下注释，根据你的实际环境填写或保持默认即可。
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 插件基础配置 (通常保持默认，无需改动)
# ------------------------------------------------------------------------------
[plugin]
name = "phone_controller"
version = "1.1.2"
config_version = "1.1.2"
enabled = true                                  # 是否开启本插件 (true=开启, false=关闭)

# ------------------------------------------------------------------------------
# 2. 受控手机与连接设置
# ------------------------------------------------------------------------------
[device]
# ADB 命令行工具路径。
# 默认填 "adb" 即可，系统会自动寻找环境变量或常见系统目录中的 adb。
# 如果你的服务器/电脑上的 adb 放在特殊路径，可以写绝对路径（例如 "/usr/bin/adb"）。
# ⚠️ 注意：为防范安全风险，请确保此处仅指向受信任的 adb 可执行文件路径。
adb_path = "adb"

# 【自动连接的主机 IP 地址】
# 适用于通过无线调试连接的手机。麦麦启动时会自动尝试连接该地址。
# - 局域网模式示例: "192.168.1.100"
# - Tailscale 专网模式示例: "100.x.x.x" (推荐，手机随身带出门也能连)
# - 如果是本机模拟器或通过 USB 线连接的电脑本机: 可以填 "127.0.0.1" 或留空
default_host = ""

# 无线调试端口号，Android 原生默认均为 5555。通常保持 5555 即可。
default_port = 5555

# 目标设备序列号 (Serial)。
# 留空表示系统会自动使用当前唯一在线的手机。
# 如果有多台手机同时在线，可以填具体 Serial（例如 "100.64.0.1:5555"）。
device_serial = ""

# ⚠️【核心安全项·必须填写】主人的账号 ID
# 作用：只有填在这里的主人，才有权限在聊天中命令麦麦操控手机，防止群友误触或调戏你的手机！
# 填写规则：
# - 支持 QQ 号（如 "12345678"）或 Discord 用户数字 ID（如 "123456789012345678"）
# - 如果有多个主人，请用英文逗号隔开，例如: "12345678, 87654321"
# ⚠️ 注意：如果这里留空，为了保护手机隐私，插件会默认拦截所有手机控制操作！
owner_qq = ""

# 设备别名快捷映射表（多机党神器，给手机起好记的人性化名字）
# 格式: "别名1=IP:端口,别名2=IP:端口"
# 示例: aliases = "备用机=100.64.0.1:5555,小米=192.168.1.50:5555"
# 配置好后，在聊天里直接对麦麦说大白话即可切换手机：
# 例如: "麦麦，连接备用机"、"麦麦，切换到小米手机"
aliases = "备用机=192.168.1.100:5555"

# 在聊天中让麦麦“看屏幕”截图时，是否自动将截图发送到聊天框中 (true=发送, false=只截不发)
auto_send_screenshot = true

# 截图压缩画质 (范围 1~100，默认 75)
# 75 已经非常清晰可读，同时单张图片大小只有 200~300KB，大幅节省服务器带宽与流量。
screenshot_quality = 75

# ------------------------------------------------------------------------------
# 3. 拟人化自主摸鱼巡航配置 (数字生命模式 ☕✨)
# ------------------------------------------------------------------------------
[slack_off]
# 是否开启摸鱼能力（支持在对话中让麦麦主动刷手机，如“麦麦，去刷刷B站”）
enabled = true

# 是否开启【闲时定时自动摸鱼巡航】
# true = 开启数字生命模式：在白天的闲暇时间，麦麦会像真人一样隔几小时偷偷玩一次手机；
# false = 关闭定时巡航，只有当你主动在聊天里叫她去刷手机时才会动。
# 💡 提示：开启前请务必先配好上面的 owner_qq！
auto_slacking = false

# 自动摸鱼的最小间隔与最大间隔（单位：小时）
# 例如最小 2.0，最大 4.0，表示每次玩完手机后，随机休息 2 到 4 个小时再玩下一次，
# 完全模拟真人随性的生活节律，绝不机械定时。
interval_hours_min = 2.0
interval_hours_max = 4.0

# 每次玩手机的时长（单位：秒，建议 30~60 秒）
# 每次摸鱼麦麦会模拟手指滑动、停顿阅读内容，并在看到精彩画面时拍照分享给你。
session_duration_seconds = 60

# 允许玩手机的生活作息时间窗口（24 小时制 "HH:MM-HH:MM"）
# 默认 "09:00-23:00"（早上 9 点到晚上 11 点之间允许玩手机）。
# 深夜 23:00 到次日 08:00 麦麦会自动进入睡眠静默期，绝不触碰手机，彻底免打扰！
active_time_range = "09:00-23:00"

# 摸鱼完毕后是否自动灭屏锁屏 (true=自动按电源键锁屏待机，极度省电)
lock_screen_after_slack = true

# 麦麦爱逛的应用池（用英文逗号隔开）
# 目前完整支持：b站, 知乎, 小红书, 抖音
# 麦麦每次摸鱼会从中随机挑一个打开闲逛。如果手机里只装了其中几个，可以只写装了的。
preferred_apps = "b站,知乎,小红书,抖音"

# 刷到精彩/有趣内容时，是否自动抓取高清截图分享给主人 (true=是, false=否)
share_interesting_finds = true

# 摸鱼结束时是否发送打卡结算简报 (默认 false)
# - false (推荐)：极简防打扰模式。平时安静摸鱼，只有真正抓到了有趣的精彩截图时，才会带图找你吐槽；
# - true：打卡汇报模式。每次摸鱼结束锁屏前，即便没抓到特定大图，也会发一句文字打卡告诉你她刚玩了什么。
notify_summary = false

# 模拟人类阅读时的手指停顿秒数（最短停留与最长停留）
# 麦麦划动一下屏幕后，会在此区间内随机停顿几秒，模拟真人在看视频或读文章。
swipe_interval_min = 3.0
swipe_interval_max = 7.0

# 【主要通知目标】(notify_stream_id)
# 作用：指定麦麦摸鱼抓到精彩内容时，优先发给谁。
# 填写规则（极简大白话）：
# - 直接填写你的 QQ 号（如 "12345678"）或 Discord 用户 ID。
# - 优先使用该通道！当同一 QQ 号下同时存在官方机器人与小号时，系统永远优先使用更稳定的官方机器人通道。
# - 留空 ""：系统默认以 device.owner_qq 中的首个账号作为主要通知目标。
# ⚠️ 绝对不要填写底层的 32 位乱码会话 ID，填数字账号即可！
notify_stream_id = ""

# 【备用通知目标】(fallback_stream_id)
# 作用：备用容灾通道。仅当主要通知通道彻底不通或全部断连时，才启动此通道进行容灾发送！
# 填写规则：
# - 可填写备用 QQ 号或 Discord 用户 ID（例如主通道填 QQ 号，备用填 Discord ID 实现跨平台容灾）。
# - 留空 ""：不启用备用通道（主通道发送失败即静默放弃，绝不擅自乱发到其他无关窗口）。
fallback_stream_id = ""

# --- 自定义 AI 总结吐槽模型 (可选·高级项) ---
# 默认情况下，插件已完美接入麦麦内置大模型驱动小蓝人设，输出活泼自然的随性吐槽，无需配置以下三项！
# 如果你想使用独立的第三方 OpenAI 兼容大模型生成摸鱼吐槽，可以在此配置：
custom_llm_url = ""                             # 第三方 API 端点 (例如 "https://api.openai.com/v1/chat/completions")
custom_llm_key = ""                             # 第三方 API Key
custom_llm_model = "gpt-3.5-turbo"              # 第三方模型名称
