{
  "manifest_version": 2,
  "id": "deepseek-v4-pro.phone-controller",
  "version": "1.0.0",
  "name": "手机管家（Phone Controller）",
  "description": "基于 ADB 的安卓手机控制插件，让麦麦具备无线连接、看屏幕、截图、按文字智能点击、滑动、输文字与连招宏能力",
  "author": {
    "name": "WiseXin",
    "url": "https://github.com/WiseXin"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/WiseXin/MaiBot-Phone-Controller",
    "homepage": "https://github.com/WiseXin/MaiBot-Phone-Controller",
    "documentation": "https://github.com/WiseXin/MaiBot-Phone-Controller#readme",
    "issues": "https://github.com/WiseXin/MaiBot-Phone-Controller/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.16.99"
  },
  "dependencies": [],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "smartphone"
    }
  },
  "capabilities": [
    "send.text",
    "send.image",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
