{
  "manifest_version": 2,
  "id": "WiseXin.phone-controller",
  "version": "1.1.0",
  "name": "麦麦的手机",
  "description": "让麦麦拥有属于自己的实体安卓手机！支持无线调试秒连、看屏幕截图、按文字智能点击、中文打字、多设备别名无缝切换，更具备闲时自动摸鱼刷B站知乎并向主人幽默吐槽分享的真正数字生命能力。",
  "author": {
    "name": "WiseXin",
    "url": "https://github.com/WiseXin"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/WiseXin/MaiBot-Phone-Controller",
    "homepage": "https://github.com/WiseXin/MaiBot-Phone-Controller",
    "documentation": "https://github.com/WiseXin/MaiBot-Phone-Controller#readme",
    "issues": "https://github.com/WiseXin/MaiBot-Phone-Controller/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.16.99"
  },
  "dependencies": [],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "smartphone"
    }
  },
  "capabilities": [
    "send.text",
    "send.image"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
